
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# BaGet local instance
# nupkgs/ больше не игнорируется: это рабочая копия, из которой пакеты
# кладутся в packages/ для коммита. Одноимённая копия в packages/ —
# источник правды, её в git держим намеренно.
baget-data/
nupkgs/

# Secrets — никогда в индекс
.credentials.env
.secrets/
# Ключ публикации BaGet (BAGET_APIKEY) — генерируется на каждом сервере
.env

# macOS
.DS_Store

# Python
__pycache__/
*.pyc
